# ── Qdrant Cloud ────────────────────────────────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=visual_rag_pages

# ── Modal ColPali embedder (two deployed endpoint URLs) ─────────
# Printed by `modal deploy embedder/modal_app.py`
MODAL_EMBED_IMAGES_URL=https://YOU--colpali-embedder-embed-images.modal.run
MODAL_EMBED_QUERIES_URL=https://YOU--colpali-embedder-embed-queries.modal.run

# ── Vercel Blob (image storage) ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── OpenAI (GPT-4o vision answering + agent) ────────────────────
OPENAI_API_KEY=sk-...
